{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "udonarium-axe-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // 画像と音声を SHA-256 の名前で置く。保持期間はバケットのライフサイクル規則で決める（README 参照）
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "udonarium-axe-assets" }],
  "ratelimits": [
    // 新しく置くアップロードを、送信元（IPv6 は /64）ごとに数える。
    // 部屋を読み込むと画像がまとめて上がるので、余裕を持たせる
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
    // R2 から読む回数を送信元ごとに数える。データセンターのキャッシュから返すものは数えない
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "vars": {
    // カンマ区切り。PUT はこの Origin からしか受けない
    "ACCESS_CONTROL_ALLOW_ORIGIN": "http://localhost:4200",
    // バケットのライフサイクル規則と同じ日数にする
    "ASSET_RETENTION_DAYS": "30",
  },
}
