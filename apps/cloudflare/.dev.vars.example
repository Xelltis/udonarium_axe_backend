# ログイン（Discord）と部屋を使うときに入れる。3つそろえて入れるか、どれも入れないか。
# Discord のアプリ（https://discord.com/developers/applications）の「OAuth2」の Client ID と Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# トークンに署名する鍵。32文字以上の乱数（例：openssl rand -base64 48）
SESSION_SECRET=
# 管理画面（/admin）に入れる運営する人のDiscordのユーザーID（カンマ区切り）。入れると、手元でも管理画面とBANを試せる
# DiscordのアプリのRedirectsに http://localhost:8787/admin/login/callback も足す
ADMIN_DISCORD_IDS=
# 運営する人への知らせを送るDiscordのWebhookのURL（https://discord.com/api/webhooks/…）。入れなければ知らせは送らない
ADMIN_WEBHOOK_URL=
