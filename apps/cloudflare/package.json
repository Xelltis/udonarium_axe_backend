{
  "name": "udonarium-axe-backend-cloudflare",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest --run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:bcdice": "node scripts/generate-bcdice-importers.mjs && prettier --write src/core/dice/bcdice-importers.generated.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "bcdice": "4.10.0",
    "hono": "^4.13.11",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.12",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  },
  "cloudflare": {
    "bindings": {
      "ASSETS": {
        "description": "部屋の画像と音声を置くR2バケット。新しく作られる（アカウントでR2を使い始めておく必要がある）"
      },
      "ACCESS_CONTROL_ALLOW_ORIGIN": {
        "description": "アプリ（Udonarium Axe）を配信しているOrigin。複数あるときはカンマで区切る。例：`https://axe.example.com`"
      },
      "ROOM_RETENTION_HOURS": {
        "description": "部屋から最後の1人が出てから、部屋とその画像と音声を消すまでの時間"
      },
      "DISCORD_CLIENT_ID": {
        "description": "ログインに使う[Discordのアプリ](https://discord.com/developers/applications)の「OAuth2 → Client ID」。部屋を使うには、ログインの3つがそろっている必要がある"
      },
      "DISCORD_CLIENT_SECRET": {
        "description": "同じアプリの「OAuth2 → Client Secret」。ログインの3つは、そろえて入れるか、どれも入れないか"
      },
      "SESSION_SECRET": {
        "description": "トークンに署名する鍵。32文字以上の乱数（例：`openssl rand -base64 48`の出力）"
      }
    }
  }
}
