# Settings shared by the wrapper scripts in bin/.
# It is sourced by bin/phpstan and bin/php-cs-fixer.
#
# Environment variables can override them:
#   DOCKER_IMAGE      - The name of the Docker image to use.
#   DOCKER_CONTAINER_ROOT - The project root inside the container.

# The name of the Docker image (keep it the same as image: in compose.yml).
DOCKER_IMAGE="${DOCKER_IMAGE:-udonarium-axe-backend-app}"

# The path the project root is mounted at inside the container
# (keep it the same as WORKDIR and DocumentRoot in the Dockerfile).
DOCKER_CONTAINER_ROOT="${DOCKER_CONTAINER_ROOT:-/var/www/html}"
