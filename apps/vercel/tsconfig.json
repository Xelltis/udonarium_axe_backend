{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["vitest/globals", "node"],
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "test/shared"]
}
