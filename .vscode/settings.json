{
  // Settings for the PHPStan extension (sanderronde.phpstan-vscode)
  // Calls PHPStan in the Docker container through the bin/phpstan wrapper
  "phpstan.binPath": "${workspaceFolder}/apps/php/bin/phpstan",
  "phpstan.configFile": "${workspaceFolder}/apps/php/phpstan.neon",

  // Analyzes a file when it is saved
  "phpstan.singleFileMode": false,
  "phpstan.enabled": true,

  // Files in vendor/ are not analyzed
  "phpstan.paths": {
    "/var/www/html": "${workspaceFolder}/apps/php"
  },

  // Settings for the php-cs-fixer extension (junstyle.php-cs-fixer)
  // Calls php-cs-fixer in the Docker container through the bin/php-cs-fixer wrapper
  "php-cs-fixer.executablePath": "${workspaceFolder}/apps/php/bin/php-cs-fixer",
  "php-cs-fixer.config": "apps/php/.php-cs-fixer.php",
  "php-cs-fixer.onsave": true,

  // Makes php-cs-fixer the default formatter for PHP files
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },

  // File associations
  "files.associations": {
    "*.php": "php"
  },

  // Settings for the PHPUnit extension (recca0120.vscode-phpunit)
  // The extension puts its command together as "{php} {phpunit} [args]",
  // so the bin/php wrapper is given as the PHP binary
  "phpunit.php": "${workspaceFolder}/apps/php/bin/php",
  "phpunit.phpunit": "vendor/bin/phpunit",
  "phpunit.xml": "${workspaceFolder}/apps/php/phpunit.xml"
}
